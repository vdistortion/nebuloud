# Copy to .env on the VPS and replace every value with a real secret.

POSTGRES_USER=nebuloud
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nebuloud

DIRECTUS_KEY=replace-with-a-long-random-key
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-random-password

GARAGE_BUCKET=nebuloud
GARAGE_ACCESS_KEY_ID=replace-with-garage-key-id
GARAGE_SECRET_ACCESS_KEY=replace-with-garage-secret
